{
  "name": "groklab",
  "version": "0.1.0",
  "description": "Understand any codebase: lenses that explain code through one question, quizzes that prove you got it, practice that makes you write it back.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "groklab": "dist/cli.js"
  },
  "files": [
    "dist",
    "demo",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "learning",
    "code-understanding",
    "quiz",
    "lens",
    "claude",
    "ai"
  ],
  "scripts": {
    "dev": "concurrently -k -n api,web -c blue,magenta \"tsx watch src/cli.ts --no-open --port 4711\" \"vite\"",
    "build": "vite build && tsup",
    "start": "node dist/cli.js",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p web/tsconfig.json"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "0.69.0",
    "@hono/node-server": "1.19.18",
    "hono": "4.12.0",
    "ts-fsrs": "5.4.2",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@codemirror/language-data": "6.5.1",
    "@codemirror/theme-one-dark": "6.1.2",
    "@fontsource-variable/inter": "5.1.0",
    "@fontsource-variable/jetbrains-mono": "5.1.0",
    "@tanstack/react-query": "5.62.7",
    "@types/d3-force": "3.0.10",
    "@types/node": "22.10.2",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@uiw/react-codemirror": "4.23.7",
    "@vitejs/plugin-react": "4.3.4",
    "autoprefixer": "10.4.20",
    "clsx": "2.1.1",
    "concurrently": "9.1.0",
    "d3-force": "3.0.0",
    "lucide-react": "0.468.0",
    "mermaid": "11.4.1",
    "playwright-core": "1.49.1",
    "postcss": "8.4.49",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-markdown": "9.0.1",
    "react-router-dom": "6.28.0",
    "remark-gfm": "4.0.0",
    "shiki": "1.29.2",
    "tailwindcss": "3.4.17",
    "tsup": "8.3.5",
    "tsx": "4.19.2",
    "typescript": "5.7.2",
    "vite": "5.4.11",
    "vitest": "2.1.8"
  }
}
